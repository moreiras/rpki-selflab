# RPKI SelfLab desktop: one browser, one terminal, two workspaces.
# Alt is the modifier (the Windows/Cmd key is often taken by the host).
set $mod Mod1

font pango:DejaVu Sans Mono 11
default_border pixel 2
focus_follows_mouse no
output * bg #0b1020 solid_color

# keyboard layouts: US, Brazilian (ABNT2) and Spanish; Alt+Space switches
input type:keyboard {
    xkb_layout us,br,es
    xkb_options grp:alt_space_toggle
}

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Return exec foot -D /opt/lab
bindsym $mod+Shift+q kill
bindsym $mod+f fullscreen

# workspace 1: the browser (the panel, with the guide); workspace 2: a terminal
assign [app_id="firefox"] workspace number 1
assign [app_id="foot"] workspace number 2
exec firefox
exec foot -D /opt/lab
workspace number 1

bar {
    position bottom
    status_command /usr/local/bin/selflab-status
    colors {
        background #121a33
        statusline #97a1c4
    }
}
